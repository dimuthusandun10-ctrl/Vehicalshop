rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════
    // 1. HELPER FUNCTIONS (Single Source of Truth: /users/{uid})
    // ═══════════════════════════════════════════════
    
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function currentRole() {
      return hasUserDoc() && ('role' in getUserData()) ? getUserData().role : '';
    }
    
    function currentShopId() {
      return hasUserDoc() && ('shopId' in getUserData()) ? getUserData().shopId : null;
    }
    
    // Superadmin identified EITHER by Firestore role OR break-glass emergency email:
    function isSuper() {
      return isSignedIn() && (
        currentRole() == 'superadmin' ||
        request.auth.token.email in [
          'info.dimuthudishan2002@gmail.com',
          'dimuthusandun10@gmail.com',
          'superadmin@autoparts.local',
          'superadmin@autoparts.lk'
        ]
      );
    }
    
    function isAdmin() {
      return isSignedIn() && (
        currentRole() in ['admin', 'superadmin'] || 
        isSuper() ||
        request.auth.token.email in ['admin@autoparts.local']
      );
    }
    
    function isCashier() {
      return isSignedIn() && currentRole() == 'cashier';
    }
    
    function isStaff() {
      return isSignedIn() && (isSuper() || isAdmin() || (currentRole() in ['admin', 'cashier', 'superadmin']));
    }
    
    // Shop Scoped Isolation (Superadmin has multi-shop access; others scoped to own shop)
    function sameShop(resourceShopId) {
      return isSuper() || (
        currentShopId() != null && 
        currentShopId() == resourceShopId
      );
    }

    // ═══════════════════════════════════════════════
    // 2. USERS COLLECTION
    // ═══════════════════════════════════════════════
    
    match /users/{uid} {
      // Read: Self OR Superadmin OR Staff in same shop
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isSuper() ||
        (isStaff() && resource != null && ('shopId' in resource.data) && resource.data.shopId == currentShopId())
      );
      
      // Create: 
      // 1) Superadmin can create any user
      // 2) Shop Admin can create ONLY Cashiers for their own shop
      // 3) Regular users / Cashiers CANNOT create user docs (PREVENTS PRIVILEGE ESCALATION)
      allow create: if isSignedIn() && (
        isSuper() ||
        (isAdmin() && 
         request.resource.data.role == 'cashier' && 
         request.resource.data.shopId == currentShopId())
      );
      
      // Update:
      // 1) Superadmin can update any user doc
      // 2) Shop Admin can update Cashiers in their own shop
      // 3) Self can update basic profile info, but CANNOT change role, shopId, or permissions!
      allow update: if isSignedIn() && (
        isSuper() ||
        (isAdmin() && 
         resource != null && 
         resource.data.shopId == currentShopId() && 
         resource.data.role == 'cashier' &&
         request.resource.data.role == 'cashier' &&
         request.resource.data.shopId == currentShopId()) ||
        (request.auth.uid == uid &&
         resource != null &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'shopId', 'permissions']))
      );
      
      // Delete: Superadmin only
      allow delete: if isSuper();
    }

    // ═══════════════════════════════════════════════
    // 3. SHOPS COLLECTION
    // ═══════════════════════════════════════════════
    
    match /shops/{shopId} {
      // Authenticated users can read shop list/metadata (needed for login, receipts & UI)
      allow read: if isSignedIn();
      allow write: if isSuper();
    }

    // ═══════════════════════════════════════════════
    // 4. PRODUCTS
    // ═══════════════════════════════════════════════
    
    match /products/{productId} {
      allow read: if isStaff();
      allow create: if isSuper() || isAdmin();
      // Staff (Cashiers & Admins) can update product stock on sale/return
      // Prevent negative stock overselling at DB level:
      allow update: if isStaff() &&
        (!('qty' in request.resource.data) || request.resource.data.qty >= 0);
      allow delete: if isSuper() || isAdmin();
    }

    // ═══════════════════════════════════════════════
    // 5. SALES
    // ═══════════════════════════════════════════════
    
    match /sales/{saleId} {
      allow read: if isStaff() && sameShop(resource.data.shopId);
      allow create: if isSuper() ||
        (isStaff() && request.resource.data.shopId == currentShopId());
      allow update: if isSuper() || (isAdmin() && sameShop(resource.data.shopId));
      allow delete: if isSuper() || isAdmin();
    }

    // ═══════════════════════════════════════════════
    // 6. CUSTOMERS
    // ═══════════════════════════════════════════════
    
    match /customers/{customerId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin() || isSuper();
    }

    // ═══════════════════════════════════════════════
    // 7. GRNS (Goods Received Notes)
    // ═══════════════════════════════════════════════
    
    match /grns/{grnId} {
      allow read: if isStaff() && sameShop(resource.data.shopId);
      allow create, update: if isSuper() ||
        (isAdmin() && sameShop(request.resource.data.shopId));
      allow delete: if isSuper() || isAdmin();
    }

    // ═══════════════════════════════════════════════
    // 8. RETURNS
    // ═══════════════════════════════════════════════
    
    match /returns/{returnId} {
      allow read: if isStaff() && sameShop(resource.data.shopId);
      allow create, update: if isStaff() &&
        sameShop(request.resource.data.shopId);
      allow delete: if isSuper() || isAdmin();
    }

    // ═══════════════════════════════════════════════
    // 9. SHIFTS
    // ═══════════════════════════════════════════════
    
    match /shifts/{shiftId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSuper() || isAdmin();
    }

    // ═══════════════════════════════════════════════
    // 10. CASH MOVEMENTS (Petty Cash)
    // ═══════════════════════════════════════════════
    
    match /cashMovements/{moveId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSuper() || isAdmin();
    }

    // ═══════════════════════════════════════════════
    // 11. CREDIT PAYMENTS
    // ═══════════════════════════════════════════════
    
    match /creditPayments/{paymentId} {
      allow read: if isStaff() && sameShop(resource.data.shopId);
      allow create: if isSuper() ||
        (isStaff() && request.resource.data.shopId == currentShopId());
      allow delete: if isSuper() || isAdmin();
    }

    // ═══════════════════════════════════════════════
    // 12. SUPPLIERS
    // ═══════════════════════════════════════════════
    
    match /suppliers/{supplierId} {
      allow read: if isStaff();
      allow create, update: if isSuper() ||
        (isAdmin() && sameShop(request.resource.data.shopId));
      allow delete: if isSuper() || isAdmin();
    }

    // ═══════════════════════════════════════════════
    // 13. DAILY SUMMARY
    // ═══════════════════════════════════════════════
    
    match /dailySummary/{summaryId} {
      allow read: if isStaff();
      allow write: if isSuper() ||
        (isStaff() && request.resource.data.shopId == currentShopId());
      allow delete: if isSuper() || isAdmin();
    }

    // ═══════════════════════════════════════════════
    // 14. ACTIVITY LOG (Audit Trail)
    // ═══════════════════════════════════════════════
    
    match /activityLog/{logId} {
      allow read: if isSuper() || isAdmin();
      allow create: if isStaff();
      allow update, delete: if isSuper();
    }

    // ═══════════════════════════════════════════════
    // 15. COUNTERS (Atomic Global Invoice Counters)
    // ═══════════════════════════════════════════════
    
    match /counters/{counterId} {
      allow read, write: if isStaff();
    }

    // ═══════════════════════════════════════════════
    // 16. SUPPLIER PAYMENTS & CHEQUES LEDGER
    // ═══════════════════════════════════════════════
    
    match /supplierPayments/{paymentId} {
      allow read: if isStaff() && sameShop(resource.data.shopId);
      allow create: if isSuper() ||
        (isAdmin() && request.resource.data.shopId == currentShopId());
      allow update: if isSuper() || isAdmin();
      allow delete: if isSuper() || isAdmin();
    }

    // ═══════════════════════════════════════════════
    // 17. PART INTERCHANGE (Cross Compatibility Catalog)
    // ═══════════════════════════════════════════════
    
    match /interchanges/{interchangeId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff();
      allow delete: if isSuper() || isAdmin();
    }

    // ═══════════════════════════════════════════════
    // 18. SCRAP BATTERY (CORE) INVENTORY
    // ═══════════════════════════════════════════════
    
    match /scrapInventory/{scrapId} {
      allow read: if isStaff();
      allow create, update: if isStaff() && (request.resource.data.shopId == null || sameShop(request.resource.data.shopId));
      allow delete: if isSuper() || isAdmin();
    }

    // ═══════════════════════════════════════════════
    // 19. SETTINGS & APP CONFIG
    // ═══════════════════════════════════════════════
    
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSuper();
    }

    // ═══════════════════════════════════════════════
    // 20. DEFAULT DENY — catch-all for unknown paths
    // ═══════════════════════════════════════════════
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
