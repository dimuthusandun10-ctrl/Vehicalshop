rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return userDoc().role;
    }

    function shopId() {
      return userDoc().shopId;
    }

    function isSuper()   { return isSignedIn() && role() == 'superadmin'; }
    function isAdmin()   { return isSignedIn() && role() == 'admin'; }
    function isCashier() { return isSignedIn() && role() == 'cashier'; }
    function isStaff()   { return isSignedIn() && role() in ['cashier','admin','superadmin']; }

    function sameShop(resourceShopId){
      return isSuper() || (isStaff() && shopId() == resourceShopId);
    }

    // ============ USERS ============
    match /users/{uid} {
      // Read: self, or admin of same shop, or super
      allow read: if isSignedIn() && (
        request.auth.uid == uid || 
        isSuper() || 
        (isAdmin() && shopId() == resource.data.shopId)
      );

      // Create: super can create any, admin can create in own shop
      allow create: if isSuper() || (isAdmin() && request.resource.data.shopId == shopId());

      // Update: super any, admin own shop cashiers, self can update own profile
      allow update: if isSuper() 
                 || (isAdmin() && resource.data.shopId == shopId())
                 || (request.auth.uid == uid 
                     && request.resource.data.role == resource.data.role  // no role change
                     && request.resource.data.permissions == resource.data.permissions); // no perm change

      // Delete: super only
      allow delete: if isSuper();
    }

    // ============ SHOPS ============
    match /shops/{shopId} {
      allow read: if isStaff();
      allow create: if isSuper();
      allow update: if isSuper() || (isAdmin() && request.auth.uid in resource.data.adminIds);
      allow delete: if isSuper();
    }

    // ============ PRODUCTS ============
    match /products/{id} {
      allow read: if isStaff() && sameShop(resource.data.shopId);
      allow create: if isSuper() || (isAdmin() && sameShop(request.resource.data.shopId));
      allow update: if isSuper() || (isAdmin() && sameShop(resource.data.shopId));
      allow delete: if isSuper();
    }

    // ============ SALES ============
    match /sales/{id} {
      allow read: if isStaff() && sameShop(resource.data.shopId);
      allow create: if isStaff() && sameShop(request.resource.data.shopId);
      allow update: if isSuper() || (isAdmin() && sameShop(resource.data.shopId));
      allow delete: if isSuper();
    }

    // ============ CUSTOMERS ============
    match /customers/{id} {
      allow read: if isStaff() && sameShop(resource.data.shopId);
      allow create: if isSuper() || (isAdmin() && sameShop(request.resource.data.shopId));
      allow update: if isSuper() || (isAdmin() && sameShop(resource.data.shopId));
      allow delete: if isSuper();
    }

    // ============ RETURNS ============
    match /returns/{id} {
      allow read: if isStaff() && sameShop(resource.data.shopId);
      allow create: if isStaff() && sameShop(request.resource.data.shopId);
      allow update: if isSuper() || (isAdmin() && sameShop(resource.data.shopId));
    }

    // ============ GRNS ============
    match /grns/{id} {
      allow read: if isStaff() && sameShop(resource.data.shopId);
      allow create: if isSuper() || (isAdmin() && sameShop(request.resource.data.shopId));
    }

    // ============ SHIFTS ============
    match /shifts/{id} {
      allow read: if isStaff() && sameShop(resource.data.shopId);
      allow create: if isStaff() && sameShop(request.resource.data.shopId);
      allow update: if isStaff() && sameShop(resource.data.shopId);
    }

    // ============ CASH MOVEMENTS ============
    match /cashMovements/{id} {
      allow read: if isStaff() && sameShop(resource.data.shopId);
      allow create: if isStaff() && sameShop(request.resource.data.shopId);
    }

    // ============ DEFAULT DENY ============
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
