rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'superadmin' ||
        request.auth.token.role == 'superadmin'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.role == 'admin'
      );
    }

    function belongsToShop(shopId) {
      return isSuperAdmin() || (
        isAuthenticated() && getUserData().shopId == shopId
      );
    }

    // 1. Shops Collection
    match /shops/{shopId} {
      // Super Admin can manage all shops
      allow read, write: if isSuperAdmin();
      // Admins and Cashiers can read their assigned shop
      allow read: if isAuthenticated() && (
        getUserData().shopId == shopId ||
        getUserData().shopId == resource.data.id
      );
    }

    // 2. Users Collection
    match /users/{userId} {
      // Super Admin has full control over all users
      allow read, write: if isSuperAdmin();

      // Users can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Admin can manage cashiers belonging to their own shop
      allow read: if isAdmin() && (
        resource.data.shopId == getUserData().shopId ||
        request.auth.uid == userId
      );

      allow create: if isAdmin() &&
        request.resource.data.shopId == getUserData().shopId &&
        request.resource.data.role == 'cashier';

      allow update: if (isAdmin() &&
        resource.data.shopId == getUserData().shopId &&
        request.resource.data.shopId == getUserData().shopId &&
        resource.data.role == 'cashier' &&
        request.resource.data.role == 'cashier') ||
        (isAuthenticated() && request.auth.uid == userId);

      allow delete: if isSuperAdmin();
    }

    // 3. Products, Inventory & Catalogs
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isAdmin();
    }

    // 4. Sales & Transactions (Scoped to Shop)
    match /sales/{saleId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shopId == getUserData().shopId ||
          resource.data.cashierId == request.auth.uid
        )
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.shopId == getUserData().shopId
      );
      allow update, delete: if isSuperAdmin() || (isAdmin() && resource.data.shopId == getUserData().shopId);
    }

    // 5. Shifts & Cash Movements
    match /shifts/{shiftId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shopId == getUserData().shopId ||
          resource.data.cashierId == request.auth.uid
        )
      );
      allow create, update: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.shopId == getUserData().shopId ||
        request.resource.data.cashierId == request.auth.uid
      );
      allow delete: if isSuperAdmin();
    }

    match /cashMovements/{moveId} {
      allow read, write: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.shopId == getUserData().shopId ||
        resource.data.shopId == getUserData().shopId
      );
    }

    // 6. Customers & Suppliers
    match /customers/{custId} {
      allow read, write: if isAuthenticated();
    }

    match /suppliers/{supId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isAdmin();
    }

    // 7. GRNs, Returns & Credit Settlements
    match /grns/{grnId} {
      allow read, write: if isSuperAdmin() || (isAdmin() && belongsToShop(resource.data.shopId));
    }

    match /returns/{retId} {
      allow read, create: if isAuthenticated() && (isSuperAdmin() || belongsToShop(request.resource.data.shopId));
      allow update, delete: if isSuperAdmin() || (isAdmin() && belongsToShop(resource.data.shopId));
    }

    match /creditPayments/{payId} {
      allow read, write: if isAuthenticated() && (
        isSuperAdmin() ||
        belongsToShop(request.resource.data.shopId) ||
        belongsToShop(resource.data.shopId)
      );
    }

    // 8. Settings
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (isAdmin() && docId == 'shop');
    }
  }
}
